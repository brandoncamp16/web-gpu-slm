# Private settings for the backend. Copy this file to secrets.env and fill it in:
#   cp secrets.env.example secrets.env
# secrets.env is gitignored, so these values never end up in the repository.
# Docker Compose loads it into the backend container only (see docker-compose.yml).

# Required for the cloud baseline (gpt-4o-mini / gpt-4o) and the AI judge.
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: model used by the AI judge (default gpt-4o)
# JUDGE_MODEL=gpt-4o
