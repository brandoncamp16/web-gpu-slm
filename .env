# WebGPU SLM Accessibility Benchmark: development (http) settings.
# Use with: docker compose up -d --build
# The OpenAI API key does NOT go here (this file is committed): put it in secrets.env.

# Separator for the COMPOSE_FILE list below
COMPOSE_PATH_SEPARATOR=:

# Compose files merged in this mode: base + docker-compose.dev.yml (http on port 80)
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# Backend connection to MongoDB (user/password must match ADMIN_DEFAULT_PASSWORD)
MONGODB_URI=mongodb://MongoAdmin:Test1234!@mongodb:27017/docker-website?authSource=admin

# MongoDB root password, set when the database volume is first created
ADMIN_DEFAULT_PASSWORD=Test1234!

# Node.js environment for the backend
NODE_ENV=development

# Origin allowed to call the backend API (the address the app is opened from)
CORS_ORIGIN=http://localhost
