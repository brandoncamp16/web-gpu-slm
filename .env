JWT_SECRET=super_secret_local_key_123
ADMIN_DEFAULT_PASSWORD=Test1234!
NODE_ENV=development
CORS_ORIGIN=http://localhost
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Example Email <example@email.com>
